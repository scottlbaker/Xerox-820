                        
                        ;
                        ; Xerox-820 DRAM Diagnostic
                        ;
                        
   0030                 CRTPAG   EQU    30H                ; Where video RAM lives
   3000                 CRTRAM   EQU    3000H              ; ..
                        
   3c00                 RAM_LOW  EQU    03C00H             ; DRAM low test address (4K)
   ffff                 RAM_TOP  EQU    0FFFFH             ; DRAM top test address (64K)
                        
                        ; I/O ports
                        
   0000                 BRG.A    EQU    000H               ; Baud rate generator for channel A
   0000                 BRG.C    EQU    000H               ; Baud rate generator for channel A
   000c                 BRG.B    EQU    00CH               ; Baud rate generator for channel B
                        
   0004                 SIO.AD   EQU    004H               ; SIO channel A, Data port
   0004                 SIO.CD   EQU    004H               ; SIO channel A, Data port
   0005                 SIO.BD   EQU    005H               ; SIO channel B, Data port
   0006                 SIO.AS   EQU    006H               ; SIO channel A, Status port
   0006                 SIO.CS   EQU    006H               ; SIO channel A, Status port
   0007                 SIO.BS   EQU    007H               ; SIO channel B, Status port
   0008                 PIO.AD   EQU    008H               ; PIO channel A, Data port
   0009                 PIO.AS   EQU    009H               ; PIO channel A, Sts/Ctrl port
   000a                 PIO.BD   EQU    00AH               ; PIO channel B, Data port
   000b                 PIO.BS   EQU    00BH               ; PIO channel B, Sts/Ctrl port
   0010                 FDC.CS   EQU    010H               ; 1771 Floppy Controller: Ctrl/Status
   0011                 FDC.CY   EQU    011H               ; 1771 Floppy Controller: Cylinder/track
   0012                 FDC.SE   EQU    012H               ; 1771 Floppy Controller: Sector
   0013                 FDC.DA   EQU    013H               ; 1771 Floppy disc Controller: Data
   0014                 CRT.SC   EQU    014H               ; CRT Scroll control register
   0018                 CTC.C0   EQU    018H               ; Counter/Timer Chip Channel 0
   0019                 CTC.C1   EQU    019H               ; Counter/Timer Chip Channel 1
   001a                 CTC.C2   EQU    01AH               ; Counter/Timer Chip Channel 2
   001b                 CTC.C3   EQU    01BH               ; Counter/Timer Chip Channel 3
   001c                 PIO.SD   EQU    01CH               ; Data port of system PIO
   001d                 PIO.SC   EQU    01DH               ; Control port of system PIO
   001e                 PIO.KD   EQU    01EH               ; Keyboard data port of PIO
   001f                 PIO.KC   EQU    01FH               ; Keyboard control port of PIO
                        
                        ; ASCII characters
                        
   0004                 CH.EOT   EQU    004H               ; String terminator
   0007                 CH.BEL   EQU    007H               ; Bell
   0008                 CH.BS    EQU    008H               ; Backspace
   0009                 CH.HT    EQU    009H               ; Horizontal Tab
   000a                 CH.LF    EQU    00AH               ; Linefeed
   000c                 CH.FF    EQU    00CH               ; Formfeed
   000d                 CH.CR    EQU    00DH               ; carriage return
   0018                 CH.CAN   EQU    018H               ; Cancel, Control X
   001a                 CH.SUB   EQU    01AH               ; SUB, Control Z
   001b                 CH.ESC   EQU    01BH               ; Escape
   0020                 CH.CTL   EQU    020H               ; Control group less than this
   0020                 CH.SPC   EQU    020H               ; Space character
                        
                        ; Bit numbers for BIT, RES and SET instructions
                        
   0000                 B0       EQU    0
   0001                 B1       EQU    1
   0002                 B2       EQU    2
   0003                 B3       EQU    3
   0004                 B4       EQU    4
   0005                 B5       EQU    5
   0006                 B6       EQU    6
   0007                 B7       EQU    7
                        
                        ; video RAM line addresses
                        
   3000                 LINE1    EQU    CRTRAM + 0000H
   3080                 LINE2    EQU    CRTRAM + 0080H
   3100                 LINE3    EQU    CRTRAM + 0100H
   3180                 LINE4    EQU    CRTRAM + 0180H
   3200                 LINE5    EQU    CRTRAM + 0200H
   3280                 LINE6    EQU    CRTRAM + 0280H
                        
   cfff                 SP_TOP   EQU    0CFFFH             ; the stack is not used
   0c00                 VRAM_SZ  EQU    00C00H             ; VRAM size = 3K
                        
                        ; end of definitions
                        
   0000                          ORG     0000H
                        
   0000   f3            START:   DI                        ; disable interrupts
   0001   31 ff cf               LD      SP, SP_TOP        ; initial stack pointer
                        
                                 ; init system PIO port A
   0004   3e cf                  LD      A, 0CFH           ; bit mode
   0006   d3 1d                  OUT     (PIO.SC), A
   0008   3e 18                  LD      A, 018H           ; bits 3 and 4 are inputs
   000a   d3 1d                  OUT     (PIO.SC), A
   000c   3e 80                  LD      A, 080H           ; disable interrupts
   000e   d3 1d                  OUT     (PIO.SC), A
                        
                                 ; load the scroll register
   0010   3e 17                  LD      A, 23             ; top display line
   0012   d3 14                  OUT     (CRT.SC), A
                        
                                 ; clear video RAM
   0014   3e 20                  LD      A, CH.SPC         ; load the fill character (space)
   0016   21 00 30               LD      HL, CRTRAM        ; set HL to start of VRAM
   0019   77                     LD      (HL), A           ; write to the first location
   001a   11 01 30               LD      DE, CRTRAM + 1    ; set DE to the second VRAM location
   001d   01 ff 0b               LD      BC, VRAM_SZ-1     ; iteration counter
   0020   ed b0                  LDIR                      ; block copy
                        
                                 ; write message to video line #1
   0022   21 fc 00               LD      HL, MSG1          ; set HL to message start
   0025   11 00 30               LD      DE, LINE1         ; set DE to VRAM address
   0028   01 16 00               LD      BC, LEN1          ; message length
   002b   ed b0                  LDIR                      ; block copy
                        
                                 ; start of DRAM diagnostics
                        
                        ; -----------------------------------------------------------------------------
                        ; TEST_55 -- Write/Verify/ID for pattern 55h
                        ; -----------------------------------------------------------------------------
   002d                 TEST_55:
   002d   3e 55                  LD A, 55h
   002f   57                     LD D, A                 ; D = expected pattern
   0030   47                     LD B, A                 ; B = expected pattern
   0031   21 00 3c               LD HL, RAM_LOW
                        
   0034                 WRITE_55:
   0034   72                     LD (HL), D              ; write the pattern
   0035   23                     INC HL
                                 ; check if HL > RAM_TOP
   0036   7c                     LD A, H
   0037   fe 00                  CP 0                    ; compare H with FFh+1 (00h)
   0039   20 f9                  JR NZ, WRITE_55
   003b   7d                     LD A, L
   003c   fe 00                  CP 0                    ; compare L with FFh+1 (00h)
   003e   20 f4                  JR NZ, WRITE_55
                        
                                 ; verify pattern
   0040   21 00 3c               LD HL, RAM_LOW          ; reset address pointer
                        
   0043                 CHECK_55:
   0043   78                     LD A, B                 ; A = expected pattern
   0044   be                     CP (HL)                 ; compare expected with actual
   0045   20 33                  JR NZ, FAULT_55         ; jump on mismatch
   0047   23                     INC HL
                            
                                 ; check termination
   0048   7c                     LD A, H
   0049   fe 00                  CP 0                    ; compare H with FFh+1 (00h)
   004b   20 f6                  JR NZ, CHECK_55
   004d   7d                     LD A, L
   004e   fe 00                  CP 0                    ; compare L with FFh+1 (00h)
   0050   20 f1                  JR NZ, CHECK_55
                        
                        ; -----------------------------------------------------------------------------
                        ; TEST_AA -- Write/Verify/ID for pattern AAh
                        ; -----------------------------------------------------------------------------
   0052                 TEST_AA:
   0052   3e aa                  LD A, 0AAh
   0054   57                     LD D, A                 ; D = expected pattern
   0055   47                     LD B, A                 ; B = expected pattern
   0056   21 00 3c               LD HL, RAM_LOW
                        
   0059                 WRITE_AA:
   0059   72                     LD (HL), D              ; write the pattern
   005a   23                     INC HL
                                 ; check if HL > RAM_TOP
   005b   7c                     LD A, H
   005c   fe 00                  CP 0                    ; compare H with FFh+1 (00h)
   005e   20 f9                  JR NZ, WRITE_AA
   0060   7d                     LD A, L
   0061   fe 00                  CP 0                    ; compare L with FFh+1 (00h)
   0063   20 f4                  JR NZ, WRITE_AA
                        
                                 ; verify pattern
   0065   21 00 3c               LD HL, RAM_LOW          ; reset address pointer
                        
   0068                 CHECK_AA:
   0068   78                     LD A, B                 ; A = expected pattern
   0069   be                     CP (HL)                 ; compare expected with actual
   006a   20 33                  JR NZ, FAULT_AA         ; jump on mismatch
   006c   23                     INC HL
                            
                                 ; check termination
   006d   7c                     LD A, H
   006e   fe 00                  CP 0                    ; compare H with FFh+1 (00h)
   0070   20 f6                  JR NZ, CHECK_AA
   0072   7d                     LD A, L
   0073   fe 00                  CP 0                    ; compare L with FFh+1 (00h)
   0075   20 f1                  JR NZ, CHECK_AA
                        
                                 ; success path
   0077   c3 ee 00               JP SUCCESS_HALT         ; all tests passed
                        
                        ; -----------------------------------------------------------------------------
                        ; FAULT_55
                        ; State on entry: HL = failing address, A = expected (55h), B = 55h
                        ; -----------------------------------------------------------------------------
   007a                 FAULT_55:
                                 ; Calculate the Error Mask
   007a   7e                     LD A, (HL)              ; A = actual data
   007b   a8                     XOR B                   ; A = actual XOR expected
   007c   4f                     LD C, A                 ; C = error mask
   007d   1e 07                  LD E,7
   007f   cb 17         LOOP_55: RL A                    ; find the failing DRAM column
   0081   38 03                  JR C, COLUMN_FOUND_55
   0083   1d                     DEC E                   ; E = failing DRAM column
   0084   18 f9                  JR LOOP_55
                        
   0086                 COLUMN_FOUND_55:
                                 ; check A15 (bit 7)
   0086   7c                     LD A, H                 ; A = high byte of failing address
   0087   e6 80                  AND 80h                 
   0089   28 09                  JR Z, CHECK_A14_55
                        
                                 ; A15 is set (row 3 or 2)
   008b   16 02                  LD D, 2
   008d   cb 74                  BIT 6, H                ; check A14 (bit 6 of H)
   008f   28 0a                  JR Z, ROW_FOUND_55      ; if A14 is clear, it's row 2 (80h-BFh)
   0091   14                     INC D                   ; row 3
   0092   18 07                  JR ROW_FOUND_55
                        
   0094                 CHECK_A14_55:
                                 ; A15 is clear (row 0 or 1)
   0094   16 00                  LD D, 0
   0096   cb 74                  BIT 6, H                ; check A14
   0098   28 01                  JR Z, ROW_FOUND_55      ; if A14 is clear, it's row 0 (00h-3Fh)
   009a   14                     INC D                   ; row 1
                        
   009b                 ROW_FOUND_55:
                                 ; D now contains the failing row (0-3)
                                 ; final reporting
   009b   7e                     LD A, (HL)              ; A = actual data
   009c   c3 c1 00               JP ERROR_HALT           ; jump to final halt location
                        
                        ; -----------------------------------------------------------------------------
                        ; FAULT_AA
                        ; State on entry: HL = failing address, A = expected (AAh), B = AAh
                        ; -----------------------------------------------------------------------------
   009f                 FAULT_AA:
                                 ; Calculate the Error Mask
   009f   7e                     LD A, (HL)              ; A = actual data
   00a0   a8                     XOR B                   ; A = actual XOR expected
   00a1   4f                     LD C, A                 ; C = error mask
   00a2   1e 07                  LD E,7
   00a4   cb 17         LOOP_AA: RL A                    ; find the failing DRAM column
   00a6   38 03                  JR C, COLUMN_FOUND_AA
   00a8   1d                     DEC E                   ; E = failing DRAM column
   00a9   18 f9                  JR LOOP_AA
                        
   00ab                 COLUMN_FOUND_AA:
                                 ; check A15 (bit 7)
   00ab   7c                     LD A, H                 ; A = high byte of failing address
   00ac   e6 80                  AND 80h                 
   00ae   28 09                  JR Z, CHECK_A14_AA
                        
                                 ; A15 is set (row 3 or 2)
   00b0   16 02                  LD D, 2
   00b2   cb 74                  BIT 6, H                ; check A14 (bit 6 of H)
   00b4   28 0a                  JR Z, ROW_FOUND_AA      ; if A14 is clear, it's row 2 (80h-BFh)
   00b6   14                     INC D                   ; row 3
   00b7   18 07                  JR ROW_FOUND_AA
                        
   00b9                 CHECK_A14_AA:
                                 ; A15 is clear (row 0 or 1)
   00b9   16 00                  LD D, 0
   00bb   cb 74                  BIT 6, H                ; check A14
   00bd   28 01                  JR Z, ROW_FOUND_AA      ; if A14 is clear, it's row 0 (00h-3Fh)
   00bf   14                     INC D                   ; row 1
                        
   00c0                 ROW_FOUND_AA:
                                 ; D now contains the failing row (0-3)
                                 ; final reporting
   00c0   7e                     LD A, (HL)              ; A = actual data
                        
   00c1                 ERROR_HALT:
                        
                        ; -----------------------------------------------------------------------------
                        ;        Register Values on HALT
                        ;
                        ;        HL = failing memory address
                        ;        A  = actual data read (failing value)
                        ;        B  = expected data (the pattern being verified)
                        ;        D  = failing DRAM row (0-3)
                        ;        E  = failing DRAM column (0-7, corresponds to D0-D7)
                        ;        C  = error mask (expected XOR actual)
                        ;
                        ; -----------------------------------------------------------------------------
                        
                                 ; calculate the chip ID message index
   00c1   7a                     LD A, D                 ; A = row
   00c2   cb 27                  SLA A
   00c4   cb 27                  SLA A
   00c6   cb 27                  SLA A                   ; A = row * 8
   00c8   83                     ADD A, E                ; A = (row * 8) + col
                        
                                 ; lookup the chip ID message address
   00c9   6f                     LD L, A                 ; L = Index
   00ca   26 00                  LD H, 0                 ; HL = Index (16-bit index value)
   00cc   cb 25                  SLA L                   ; L = Index * 2
   00ce   cb 14                  RL H                    ; HL = Index * 2 (word index offset)
                                 
   00d0   11 22 01               LD DE, MSG_ADDR_TABLE   ; DE = pointer to address table
   00d3   19                     ADD HL, DE              ; HL = address table address + Index*2
                                 
                                 ; load HL with the chip ID message address
   00d4   5e                     LD E, (HL)              ; E = low byte of message address
   00d5   23                     INC HL
   00d6   56                     LD D, (HL)              ; D = high byte of message address
   00d7   eb                     EX DE, HL               ; HL = message address
                                 
                                 ; write chip ID message to VRAM
   00d8   01 03 00               LD BC, 3                ; BC = 3 (fixed message length)
   00db   11 80 30               LD DE, LINE2            ; DE = VRAM destination (start of line 2)
   00de   ed b0                  LDIR                    ; block copy: (HL) to (DE), length BC.
                        
                                 ; write ERROR message to VRAM
   00e0   21 1d 01               LD      HL, MSG_ERR     ; set HL to message start
   00e3   11 85 30               LD      DE, LINE2+5     ; set DE to VRAM address
   00e6   01 05 00               LD      BC, LEN_ERR     ; message length
   00e9   ed b0                  LDIR                    ; block copy
   00eb   c3 eb 00               JP      $               ; null loop
                        
   00ee                 SUCCESS_HALT:
                                 ; write PASSED message to VRAM
   00ee   21 12 01               LD      HL, MSG_OK      ; set HL to message start
   00f1   11 80 30               LD      DE, LINE2       ; set DE to VRAM address
   00f4   01 0b 00               LD      BC, LEN_OK      ; message length
   00f7   ed b0                  LDIR                    ; block copy
   00f9   c3 f9 00               JP      $               ; null loop
                        
                                 ; end of program
                        
                                 ; start of messages
                        
   00fc   58 45 52 4f   MSG1:    DB      'XEROX-820 -- DRAM TEST'
   0100   58 2d 38 32   
   0104   30 20 2d 2d   
   0108   20 44 52 41   
   010c   4d 20 54 45   
   0110   53 54         
   0016                 LEN1     EQU     $ - MSG1
                        
   0112   54 45 53 54   MSG_OK:  DB      'TEST PASSED'
   0116   20 50 41 53   
   011a   53 45 44      
   000b                 LEN_OK   EQU     $ - MSG_OK
                        
   011d   45 52 52 4f   MSG_ERR: DB      'ERROR'
   0121   52            
   0005                 LEN_ERR  EQU     $ - MSG_ERR
                        
                        ; -----------------------------------------------------------------------------

                        ;       U17   U18   U19   U20   U21   U22   U23   U24     8000h -> BFFFh
                        ;       U37   U38   U39   U40   U41   U42   U43   U44     4000h -> 7FFFh
                        ;       U54   U55   U56   U57   U58   U59   U60   U61     0000h -> 3FFFh
                        ;
                        ; -----------------------------------------------------------------------------
                        
                        ; Message table ordered by row and column
                        
   0122                 MSG_ADDR_TABLE:
   0122   aa 01 ad 01            DW MSG_00, MSG_01, MSG_02, MSG_03, MSG_04, MSG_05, MSG_06, MSG_07
   0126   b0 01 b3 01   
   012a   b6 01 b9 01   
   012e   bc 01 bf 01   
   0132   92 01 95 01            DW MSG_10, MSG_11, MSG_12, MSG_13, MSG_14, MSG_15, MSG_16, MSG_17
   0136   98 01 9b 01   
   013a   9e 01 a1 01   
   013e   a4 01 a7 01   
   0142   7a 01 7d 01            DW MSG_20, MSG_21, MSG_22, MSG_23, MSG_24, MSG_25, MSG_26, MSG_27
   0146   80 01 83 01   
   014a   86 01 89 01   
   014e   8c 01 8f 01   
   0152   62 01 65 01            DW MSG_30, MSG_31, MSG_32, MSG_33, MSG_34, MSG_35, MSG_36, MSG_37
   0156   68 01 6b 01   
   015a   6e 01 71 01   
   015e   74 01 77 01   
                        
                        ; DRAM chip IDs for range C000h -> FFFFh
                        
   0162   55 38 20      MSG_30:  DB      'U8 '
   0003                 LEN_30   EQU     $ - MSG_30
                        
   0165   55 37 20      MSG_31:  DB      'U7 '
   0003                 LEN_31   EQU     $ - MSG_31
                        
   0168   55 36 20      MSG_32:  DB      'U6 '

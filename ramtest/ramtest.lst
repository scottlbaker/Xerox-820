                        
                        ;
                        ; Xerox-820 DRAM Diagnostic (rev1.1: don't stop on first fault)
                        ;
                        
   0030                 CRTPAG   EQU    30H                ; Where video RAM lives
   3000                 CRTRAM   EQU    3000H              ; ..
                        
   3c00                 RAM_LOW  EQU    03C00H             ; DRAM low test address (4K)
   ffff                 RAM_TOP  EQU    0FFFFH             ; DRAM top test address (64K)
                        
                        ; I/O ports
                        
   0000                 BRG.A    EQU    000H               ; Baud rate generator for channel A
   0000                 BRG.C    EQU    000H               ; Baud rate generator for channel A
   000c                 BRG.B    EQU    00CH               ; Baud rate generator for channel B
                        
   0004                 SIO.AD   EQU    004H               ; SIO channel A, Data port
   0004                 SIO.CD   EQU    004H               ; SIO channel A, Data port
   0005                 SIO.BD   EQU    005H               ; SIO channel B, Data port
   0006                 SIO.AS   EQU    006H               ; SIO channel A, Status port
   0006                 SIO.CS   EQU    006H               ; SIO channel A, Status port
   0007                 SIO.BS   EQU    007H               ; SIO channel B, Status port
   0008                 PIO.AD   EQU    008H               ; PIO channel A, Data port
   0009                 PIO.AS   EQU    009H               ; PIO channel A, Sts/Ctrl port
   000a                 PIO.BD   EQU    00AH               ; PIO channel B, Data port
   000b                 PIO.BS   EQU    00BH               ; PIO channel B, Sts/Ctrl port
   0010                 FDC.CS   EQU    010H               ; 1771 Floppy Controller: Ctrl/Status
   0011                 FDC.CY   EQU    011H               ; 1771 Floppy Controller: Cylinder/track
   0012                 FDC.SE   EQU    012H               ; 1771 Floppy Controller: Sector
   0013                 FDC.DA   EQU    013H               ; 1771 Floppy disc Controller: Data
   0014                 CRT.SC   EQU    014H               ; CRT Scroll control register
   0018                 CTC.C0   EQU    018H               ; Counter/Timer Chip Channel 0
   0019                 CTC.C1   EQU    019H               ; Counter/Timer Chip Channel 1
   001a                 CTC.C2   EQU    01AH               ; Counter/Timer Chip Channel 2
   001b                 CTC.C3   EQU    01BH               ; Counter/Timer Chip Channel 3
   001c                 PIO.SD   EQU    01CH               ; Data port of system PIO
   001d                 PIO.SC   EQU    01DH               ; Control port of system PIO
   001e                 PIO.KD   EQU    01EH               ; Keyboard data port of PIO
   001f                 PIO.KC   EQU    01FH               ; Keyboard control port of PIO
                        
                        ; ASCII characters
                        
   0004                 CH.EOT   EQU    004H               ; String terminator
   0007                 CH.BEL   EQU    007H               ; Bell
   0008                 CH.BS    EQU    008H               ; Backspace
   0009                 CH.HT    EQU    009H               ; Horizontal Tab
   000a                 CH.LF    EQU    00AH               ; Linefeed
   000c                 CH.FF    EQU    00CH               ; Formfeed
   000d                 CH.CR    EQU    00DH               ; carriage return
   0018                 CH.CAN   EQU    018H               ; Cancel, Control X
   001a                 CH.SUB   EQU    01AH               ; SUB, Control Z
   001b                 CH.ESC   EQU    01BH               ; Escape
   0020                 CH.CTL   EQU    020H               ; Control group less than this
   0020                 CH.SPC   EQU    020H               ; Space character
                        
                        ; Bit numbers for BIT, RES and SET instructions
                        
   0000                 B0       EQU    0
   0001                 B1       EQU    1
   0002                 B2       EQU    2
   0003                 B3       EQU    3
   0004                 B4       EQU    4
   0005                 B5       EQU    5
   0006                 B6       EQU    6
   0007                 B7       EQU    7
                        
                        ; video RAM line addresses
                        
   3000                 LINE1    EQU    CRTRAM + 0000H
   3080                 LINE2    EQU    CRTRAM + 0080H
   3100                 LINE3    EQU    CRTRAM + 0100H
   3180                 LINE4    EQU    CRTRAM + 0180H
   3200                 LINE5    EQU    CRTRAM + 0200H
   3280                 LINE6    EQU    CRTRAM + 0280H
                        
   cfff                 SP_TOP   EQU    0CFFFH             ; the stack is not used
   0c00                 VRAM_SZ  EQU    00C00H             ; VRAM size = 3K
                        
                        ; end of definitions
                        
   0000                          ORG     0000H
                        
   0000   f3            START:   DI                        ; disable interrupts
   0001   31 ff cf               LD      SP, SP_TOP        ; initial stack pointer
                        
                                 ; init system PIO port A
   0004   3e cf                  LD      A, 0CFH           ; bit mode
   0006   d3 1d                  OUT     (PIO.SC), A
   0008   3e 18                  LD      A, 018H           ; bits 3 and 4 are inputs
   000a   d3 1d                  OUT     (PIO.SC), A
   000c   3e 80                  LD      A, 080H           ; disable interrupts
   000e   d3 1d                  OUT     (PIO.SC), A
                        
                                 ; load the scroll register
   0010   3e 17                  LD      A, 23             ; top display line
   0012   d3 14                  OUT     (CRT.SC), A
                        
                                 ; clear video RAM
   0014   3e 20                  LD      A, CH.SPC         ; load the fill character (space)
   0016   21 00 30               LD      HL, CRTRAM        ; set HL to start of VRAM
   0019   77                     LD      (HL), A           ; write to the first location
   001a   11 01 30               LD      DE, CRTRAM + 1    ; set DE to the second VRAM location
   001d   01 ff 0b               LD      BC, VRAM_SZ-1     ; iteration counter
   0020   ed b0                  LDIR                      ; block copy
                        
                                 ; write message to video line #1
   0022   21 0f 04               LD      HL, MSG1          ; set HL to message start
   0025   11 00 30               LD      DE, LINE1         ; set DE to VRAM address
   0028   01 16 00               LD      BC, LEN1          ; message length
   002b   ed b0                  LDIR                      ; block copy
                        
                                 ; clear alternate registers
   002d   08                     EX AF, AF'
   002e   d9                     EXX
   002f   af                     XOR A                     ; A' = 0
   0030   57                     LD D, A                   ; D' = 0
   0031   5f                     LD E, A                   ; E' = 0
   0032   67                     LD H, A                   ; H' = 0
   0033   6f                     LD L, A                   ; L' = 0
   0034   d9                     EXX
   0035   08                     EX AF, AF'                ; switch back
                        
                                 ; start of DRAM diagnostics
                        
                        ; -----------------------------------------------------------------------------
                        ; TEST_55 -- Write/Verify/ID for pattern 55h
                        ; -----------------------------------------------------------------------------
   0036                 TEST_55:
   0036   3e 55                  LD A, 55h
   0038   57                     LD D, A                 ; D = expected pattern
   0039   47                     LD B, A                 ; B = expected pattern
   003a   21 00 3c               LD HL, RAM_LOW
                        
   003d                 WRITE_55:
   003d   72                     LD (HL), D              ; write the pattern
   003e   23                     INC HL
                                 ; check if HL > RAM_TOP
   003f   7c                     LD A, H
   0040   fe 00                  CP 0                    ; compare H with FFh+1 (00h)
   0042   20 f9                  JR NZ, WRITE_55
   0044   7d                     LD A, L
   0045   fe 00                  CP 0                    ; compare L with FFh+1 (00h)
   0047   20 f4                  JR NZ, WRITE_55
                        
                                 ; verify-pattern loop
   0049   21 00 3c               LD HL, RAM_LOW          ; reset address pointer
   004c   78            CHK_55:  LD A, B                 ; A = expected pattern
   004d   be                     CP (HL)                 ; compare expected with actual
   004e   20 33                  JR NZ, FAULT            ; jump on mismatch
                        
                                 ; check for verify-pattern loop termination
   0050   23            CHK_5X:  INC HL
   0051   7c                     LD A, H
   0052   fe 00                  CP 0                    ; compare H with FFh+1 (00h)
   0054   20 f6                  JR NZ, CHK_55
   0056   7d                     LD A, L
   0057   fe 00                  CP 0                    ; compare L with FFh+1 (00h)
   0059   20 f1                  JR NZ, CHK_55
                        
                        ; -----------------------------------------------------------------------------
                        ; TEST_AA -- Write/Verify/ID for pattern AAh
                        ; -----------------------------------------------------------------------------
   005b                 TEST_AA:
   005b   3e aa                  LD A, 0AAh
   005d   57                     LD D, A                 ; D = expected pattern
   005e   47                     LD B, A                 ; B = expected pattern
   005f   21 00 3c               LD HL, RAM_LOW
                        
   0062                 WRITE_AA:
   0062   72                     LD (HL), D              ; write the pattern
   0063   23                     INC HL
                                 ; check if HL > RAM_TOP
   0064   7c                     LD A, H
   0065   fe 00                  CP 0                    ; compare H with FFh+1 (00h)
   0067   20 f9                  JR NZ, WRITE_AA
   0069   7d                     LD A, L
   006a   fe 00                  CP 0                    ; compare L with FFh+1 (00h)
   006c   20 f4                  JR NZ, WRITE_AA
                        
                                 ; verify-pattern loop
   006e   21 00 3c               LD HL, RAM_LOW          ; reset address pointer
   0071   78            CHK_AA:  LD A, B                 ; A = expected pattern
   0072   be                     CP (HL)                 ; compare expected with actual
   0073   20 0e                  JR NZ, FAULT            ; jump on mismatch
                        
                                 ; check for verify-pattern loop termination
   0075   23            CHK_AX:  INC HL
   0076   7c                     LD A, H
   0077   fe 00                  CP 0                    ; compare H with FFh+1 (00h)
   0079   20 f6                  JR NZ, CHK_AA
   007b   7d                     LD A, L
   007c   fe 00                  CP 0                    ; compare L with FFh+1 (00h)
   007e   20 f1                  JR NZ, CHK_AA
                        
   0080   c3 3d 02               JP REPORT               ; test complete jump to reporting
                        
                        ; -----------------------------------------------------------------------------
                        ; FAULT -- found a fault
                        ; State on entry: HL = failing address, A = expected (55h), B = 55h
                        ; -----------------------------------------------------------------------------
   0083   7e            FAULT:   LD A, (HL)              ; A = actual data
   0084   a8                     XOR B                   ; A = actual XOR expected
   0085   4f                     LD C, A                 ; C = error mask
   0086   1e 07                  LD E,7
                        
   0088   79            COL_LP:  LD A, C
   0089   fe 00                  CP 0                    ; check if done
   008b   28 08                  JR Z, COL_XX
   008d   cb 27                  SLA A
   008f   4f                     LD C, A
   0090   38 0a                  JR C, GOT_COL
   0092   1d                     DEC E                   ; E = failing DRAM column
   0093   18 f3                  JR COL_LP
                        
   0095   78            COL_XX:  LD A, B
   0096   fe 55                  CP 055h
   0098   28 b6                  JR Z, CHK_5X            ; continue test with 55 pattern
   009a   18 d9                  JR CHK_AX               ; continue test with AA pattern
                        
   009c   7c            GOT_COL: LD A, H                 ; A = high byte of failing address
   009d   e6 80                  AND 80h                 ; check A15 (bit 7)
   009f   28 09                  JR Z, ROW_10
                        
   00a1   16 02         ROW_32:  LD D, 2                 ; A15 is set (row 3 or 2)
   00a3   cb 74                  BIT 6, H                ; check A14 (bit 6 of H)
   00a5   28 0a                  JR Z, WBMAP             ; if A14 is clear, it's row 2 (80h-BFh)
   00a7   14                     INC D                   ; row 3
   00a8   18 07                  JR WBMAP
                        
   00aa   16 00         ROW_10:  LD D, 0                 ; A15 is clear (row 2 or 0)
   00ac   cb 74                  BIT 6, H                ; check A14
   00ae   28 01                  JR Z, WBMAP             ; if A14 is clear, it's row 0 (00h-3Fh)
   00b0   14                     INC D                   ; row 1
                        
                                 ; start of RAM fault bitmap section
                        
                                 ; write to 32-bit bitmap of faulting chips in DE',HL'
                                 ; D = failing row (0-3)  E = failing column (0-7)
   00b1   7a            WBMAP:   LD A, D
   00b2   d9                     EXX
   00b3   47                     LD B, A                 ; B' = D
   00b4   d9                     EXX
   00b5   7b                     LD A, E
   00b6   d9                     EXX
   00b7   4f                     LD C, A                 ; C' = E
                        
   00b8   08                     EX      AF, AF'         ; switch to alternate AF
   00b9   3e ff                  LD      A, 0FFh         ; set error flag
   00bb   08                     EX      AF, AF'         ; switch back
                        
                                 ; BC' has the failing row and col
                                 ; Calculate the 5-bit chip index (0-31) = (row * 8) + col
   00bc   78                     LD A, B                 ; A = row
   00bd   cb 27                  SLA A                   ; A = row * 2
   00bf   cb 27                  SLA A                   ; A = row * 4
   00c1   cb 27                  SLA A                   ; A = row * 8
   00c3   81                     ADD A, C                ; A = chip index (0-31)
   00c4   47                     LD B, A                 ; B' holds the chip index (0-31)
                        
                                 ; Binary Split Logic (max 4 comparisons)
                        
   00c5   78            WBX1:    LD A, B                 ; A = chip index (0-31)
   00c6   fe 10                  CP 16                   ; split 0-31 into 0-15 and 16-31
   00c8   38 14                  JR C, WBX3
                        
                                 ; range 16-31
   00ca   fe 18                  CP 24                   ; split 16-31 into 16-23 and 24-31
   00cc   38 08                  JR C, WBX2
                        
                                 ; range 24-31
   00ce   fe 1c                  CP 28                   ; split 24-31 into 24-27 and 28-31
   00d0   da e6 01               JP C, WBP24             ; jump to WBP24 for range 24-27
   00d3   c3 0f 02               JP WBP28                ; jump to WBP28 for range 28-31
                        
   00d6                 WBX2:    ; range 16-23
   00d6   fe 14                  CP 20                   ; split 16-23 into 16-19 and 20-23
   00d8   da 94 01               JP C, WBP16             ; jump to WBP16 for range 16-19
   00db   c3 bd 01               JP WBP20                ; jump to WBP20 for range 20-23
                        
                                 ; range 0-15
   00de   fe 08         WBX3:    CP 8                    ; split 0-15 into 0-7 and 8-15
   00e0   38 07                  JR C, WBX4
                        
                                 ; range 8-15
   00e2   fe 0c                  CP 12                   ; split 8-15 into 8-11 and 12-15
   00e4   38 5c                  JR C, WBP8              ; jump to WBP8 for range 8-11
   00e6   c3 6b 01               JP WBP12                ; jump to WBP12 for range 12-15
                        
                                 ; range 0-7
   00e9   fe 04         WBX4:    CP 4                    ; split 0-7 into 0-3 and 4-7
   00eb   38 03                  JR C, WBP0              ; jump to WBP0 for range 0-3
   00ed   c3 19 01               JP WBP4                 ; jump to WBP4 for range 4-7
                        
                        ; Range 0-3
                        
   00f0   78            WBP0:    LD A, B
   00f1   fe 00                  CP 0
   00f3   20 07                  JR NZ, WBP1
   00f5   7d                     LD A, L
   00f6   f6 01                  OR 01h                  ; bit 0
   00f8   6f                     LD L, A
   00f9   c3 38 02               JP WBPXX
                        
   00fc   fe 01         WBP1:    CP 1
   00fe   20 07                  JR NZ, WBP2
   0100   7d                     LD A, L
   0101   f6 02                  OR 02h                  ; bit 1
   0103   6f                     LD L, A
   0104   c3 38 02               JP WBPXX
                        
   0107   fe 02         WBP2:    CP 2
   0109   20 07                  JR NZ, WBP3
   010b   7d                     LD A, L
   010c   f6 04                  OR 04h                  ; bit 2
   010e   6f                     LD L, A
   010f   c3 38 02               JP WBPXX
                        
   0112   7d            WBP3:    LD A, L
   0113   f6 08                  OR 08h                  ; bit 3
   0115   6f                     LD L, A
   0116   c3 38 02               JP WBPXX
                        
                        ; Range 4-7
                        
   0119   78            WBP4:    LD A, B
   011a   fe 04                  CP 4
   011c   20 07                  JR NZ, WBP5
   011e   7d                     LD A, L
   011f   f6 10                  OR 10h                  ; bit 4
   0121   6f                     LD L, A
   0122   c3 38 02               JP WBPXX
                        
   0125   fe 05         WBP5:    CP 5
   0127   20 07                  JR NZ, WBP6
   0129   7d                     LD A, L
   012a   f6 20                  OR 20h                  ; bit 5
   012c   6f                     LD L, A
   012d   c3 38 02               JP WBPXX
                        
   0130   fe 06         WBP6:    CP 6
   0132   20 07                  JR NZ, WBP7
   0134   7d                     LD A, L
   0135   f6 40                  OR 40h                  ; bit 6
   0137   6f                     LD L, A
   0138   c3 38 02               JP WBPXX
                        
   013b   7d            WBP7:    LD A, L
   013c   f6 80                  OR 80h                  ; bit 7
   013e   6f                     LD L, A
   013f   c3 38 02               JP WBPXX
                        
                        ; Range 8-11
                        
   0142   78            WBP8:    LD A, B
   0143   fe 08                  CP 8
   0145   20 07                  JR NZ, WBP9
   0147   7c                     LD A, H
   0148   f6 01                  OR 01h                  ; bit 8
   014a   67                     LD H, A
   014b   c3 38 02               JP WBPXX
                        
   014e   fe 09         WBP9:    CP 9
   0150   20 07                  JR NZ, WBP10
   0152   7c                     LD A, H
   0153   f6 02                  OR 02h                  ; bit 9
   0155   67                     LD H, A
   0156   c3 38 02               JP WBPXX
                        
   0159   fe 0a         WBP10:   CP 10
   015b   20 07                  JR NZ, WBP11
   015d   7c                     LD A, H
   015e   f6 04                  OR 04h                  ; bit 10
   0160   67                     LD H, A
   0161   c3 38 02               JP WBPXX
                        
   0164   7c            WBP11:   LD A, H                 ; B must be 11
   0165   f6 08                  OR 08h                  ; bit 11
   0167   67                     LD H, A
   0168   c3 38 02               JP WBPXX
                        
                        ; Range 12-15
                        
   016b   78            WBP12:   LD A, B
   016c   fe 0c                  CP 12
   016e   20 07                  JR NZ, WBP13
   0170   7c                     LD A, H
   0171   f6 10                  OR 10h                  ; bit 12
   0173   67                     LD H, A
   0174   c3 38 02               JP WBPXX
                        
   0177   fe 0d         WBP13:   CP 13
   0179   20 07                  JR NZ, WBP14
   017b   7c                     LD A, H
   017c   f6 20                  OR 20h                  ; bit 13
   017e   67                     LD H, A
   017f   c3 38 02               JP WBPXX
                        
   0182   fe 0e         WBP14:   CP 14
   0184   20 07                  JR NZ, WBP15
   0186   7c                     LD A, H
   0187   f6 40                  OR 40h                  ; bit 14
   0189   67                     LD H, A
   018a   c3 38 02               JP WBPXX
                        
   018d   7c            WBP15:   LD A, H                 ; B must be 15
   018e   f6 80                  OR 80h                  ; bit 15
   0190   67                     LD H, A
   0191   c3 38 02               JP WBPXX
                        
                        ; Range 16-19
                        
   0194   78            WBP16:   LD A, B
   0195   fe 10                  CP 16
   0197   20 07                  JR NZ, WBP17
   0199   7b                     LD A, E
   019a   f6 01                  OR 01h                  ; bit 16
   019c   5f                     LD E, A
   019d   c3 38 02               JP WBPXX
                        
   01a0   fe 11         WBP17:   CP 17
   01a2   20 07                  JR NZ, WBP18
   01a4   7b                     LD A, E
   01a5   f6 02                  OR 02h                  ; bit 17
   01a7   5f                     LD E, A
   01a8   c3 38 02               JP WBPXX
                        
   01ab   fe 12         WBP18:   CP 18
   01ad   20 07                  JR NZ, WBP19
   01af   7b                     LD A, E
   01b0   f6 04                  OR 04h                  ; bit 18
   01b2   5f                     LD E, A
   01b3   c3 38 02               JP WBPXX
                        
   01b6   7b            WBP19:   LD A, E                 ; B must be 19
   01b7   f6 08                  OR 08h                  ; bit 19
   01b9   5f                     LD E, A
   01ba   c3 38 02               JP WBPXX
                        
                        ; Range 20-23
                        
   01bd   78            WBP20:   LD A, B
   01be   fe 14                  CP 20
   01c0   20 07                  JR NZ, WBP21
   01c2   7b                     LD A, E
   01c3   f6 10                  OR 10h                  ; bit 20
   01c5   5f                     LD E, A
   01c6   c3 38 02               JP WBPXX
                        
   01c9   fe 15         WBP21:   CP 21
   01cb   20 07                  JR NZ, WBP22
   01cd   7b                     LD A, E
   01ce   f6 20                  OR 20h                  ; bit 21
   01d0   5f                     LD E, A
   01d1   c3 38 02               JP WBPXX
                        
   01d4   fe 16         WBP22:   CP 22
   01d6   20 07                  JR NZ, WBP23
   01d8   7b                     LD A, E
   01d9   f6 40                  OR 40h                  ; bit 22
   01db   5f                     LD E, A
   01dc   c3 38 02               JP WBPXX
                        
   01df   7b            WBP23:   LD A, E                 ; B must be 23
   01e0   f6 80                  OR 80h                  ; bit 23
   01e2   5f                     LD E, A
   01e3   c3 38 02               JP WBPXX
                        
                        ; Range 24-27
                        
   01e6   78            WBP24:   LD A, B
   01e7   fe 18                  CP 24
   01e9   20 07                  JR NZ, WBP25
   01eb   7a                     LD A, D
   01ec   f6 01                  OR 01h                  ; bit 24
   01ee   57                     LD D, A
   01ef   c3 38 02               JP WBPXX
                        
   01f2   fe 19         WBP25:   CP 25
   01f4   20 07                  JR NZ, WBP26
   01f6   7a                     LD A, D
   01f7   f6 02                  OR 02h                  ; bit 25
   01f9   57                     LD D, A
   01fa   c3 38 02               JP WBPXX
                        
   01fd   fe 1a         WBP26:   CP 26
   01ff   20 07                  JR NZ, WBP27
   0201   7a                     LD A, D
   0202   f6 04                  OR 04h                  ; bit 26
   0204   57                     LD D, A
   0205   c3 38 02               JP WBPXX
                        
   0208   7a            WBP27:   LD A, D                 ; B must be 27
   0209   f6 08                  OR 08h                  ; bit 27
   020b   57                     LD D, A
   020c   c3 38 02               JP WBPXX
                        
                        ; Range 28-31
                        
   020f   78            WBP28:   LD A, B
   0210   fe 1c                  CP 28
   0212   20 07                  JR NZ, WBP29
   0214   7a                     LD A, D
   0215   f6 10                  OR 10h                  ; bit 28
   0217   57                     LD D, A
   0218   c3 38 02               JP WBPXX
                        
   021b   fe 1d         WBP29:   CP 29
   021d   20 07                  JR NZ, WBP30
   021f   7a                     LD A, D
   0220   f6 20                  OR 20h                  ; bit 29
   0222   57                     LD D, A
   0223   c3 38 02               JP WBPXX
                        
   0226   fe 1e         WBP30:   CP 30
   0228   20 07                  JR NZ, WBP31
   022a   7a                     LD A, D
   022b   f6 40                  OR 40h                  ; bit 30
   022d   57                     LD D, A
   022e   c3 38 02               JP WBPXX
                        
   0231   7a            WBP31:   LD A, D                 ; B must be 31
   0232   f6 80                  OR 80h                  ; bit 31
   0234   57                     LD D, A
   0235   c3 38 02               JP WBPXX
                        
                                 ; end of RAM fault bitmap section
                        
   0238   d9            WBPXX:   EXX                     ; Swap back
   0239   1d                     DEC E                   ; E = failing DRAM column
   023a   c3 88 00               JP COL_LP               ; continue searching columns
                        
                        ; -----------------------------------------------------------------------------
                        ; REPORT -- use DE' HL' bitmap to generate a final report
                        ; -----------------------------------------------------------------------------
   023d   08            REPORT:  EX AF, AF'              ; check A'
   023e   b7                     OR A                    ; check if A' is zero (no error)
   023f   ca 00 04               JP Z, SUCCESS           ; the test passed if A'=0
                        
   0242   08                     EX AF, AF'              ; restore AF
   0243   d9            FNL3X:   EXX
   0244   7a                     LD A, D
   0245   d9                     EXX
   0246   11 80 30               LD DE, LINE2            ; DE = VRAM destination (start of line 2)
                        
   0249   cb 7f         FNL37:   BIT 7, A
   024b   28 09                  JR Z, FNL36
   024d   21 85 04               LD HL, MSG_37           ; HL = pointer to message
   0250   01 02 00               LD BC, 2                ; BC = message length
   0253   ed b0                  LDIR                    ; block copy: (HL) to (DE)
   0255   13                     INC DE
                        
   0256   cb 77         FNL36:   BIT 6, A
   0258   28 09                  JR Z, FNL35
   025a   21 82 04               LD HL, MSG_36           ; HL = pointer to message
   025d   01 02 00               LD BC, 2                ; BC = message length
   0260   ed b0                  LDIR                    ; block copy: (HL) to (DE)
   0262   13                     INC DE
                        
   0263   cb 6f         FNL35:   BIT 5, A
   0265   28 09                  JR Z, FNL34
   0267   21 7f 04               LD HL, MSG_35           ; HL = pointer to message
   026a   01 02 00               LD BC, 2                ; BC = message length
   026d   ed b0                  LDIR                    ; block copy: (HL) to (DE)
   026f   13                     INC DE
                        
